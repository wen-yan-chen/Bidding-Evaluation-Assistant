# 复制为 .env 后按需修改；compose 会自动读取同目录的 .env
# 不改也能起：compose 里每一项都有默认值

# ---- 端口（宿主机）----
HOST_PORT=8080
MCP_PORT=8765

# ---- 构建 ----
# 国内网络默认走清华源；如需官方源改为 https://pypi.org/simple
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
APP_TAG=0.9.0

# ---- 运行时 ----
APP_ENV=docker
LOG_LEVEL=info
MAX_UPLOAD_MB=50

# ---- 管理员入口（系统状态 + 数据管理）----
# 生产/演示环境务必改掉默认密码；留空则管理员登录返回 503
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# 会话签名密钥，建议 32 字节随机串；留空则每次重启失效
ADMIN_SESSION_SECRET=change-me-too
ADMIN_SESSION_TTL=28800

# ---- OCR（D3）----
# OCR_ENABLE=1
# OCR_DPI=200
# OCR_MIN_CONF=0.30

# ---- Nexent 平台（D7 端到端联调时填）----
# NEXENT_BASE=http://host.docker.internal:5013
# NEXENT_API_KEY=
# MCP_URL=http://mcp:8765/sse
